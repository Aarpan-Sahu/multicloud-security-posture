# Copy to .env (never commit it). Every value is optional; leave blank to use SDK defaults.

# ---- AWS: named profile and/or a scanner role to assume (see terraform/aws/scanner-role)
AWS_PROFILE=
AWS_REGIONS=us-east-1,us-west-2
AWS_SCANNER_ROLE_ARN=
AWS_SCANNER_EXTERNAL_ID=

# ---- Azure: uses DefaultAzureCredential (az login, managed identity, or workload identity)
AZURE_SUBSCRIPTION_IDS=

# ---- GCP: uses Application Default Credentials (gcloud auth application-default login)
GCP_PROJECT_IDS=

# ---- AI (optional). Without a key the app shows rule-catalog remediation instead.
ANTHROPIC_API_KEY=
CSPM_LLM_MODEL=claude-sonnet-5

# ---- Where scans are saved / loaded
CSPM_SNAPSHOT=data/findings.json
